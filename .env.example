# Local PostgreSQL via docker compose
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=postgres
DB_POSTGRES_DB=splitgo

# Runtime database connection.
# In production use the pooled connection string (Neon pooler/PgBouncer).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitgo?schema=public

# Direct connection used only by migrations and database tooling.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/splitgo?schema=public

# Public URL used by metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: maximum connections per serverless instance.
DB_POOL_MAX=5

# Optional: password used by npm run db:seed in development.
SEED_USER_PASSWORD=

# Optional rate limit overrides. Defaults are applied when omitted.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_IP_MAX=50
RATE_LIMIT_LOGIN_IP_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_INVITE_MAX=50
RATE_LIMIT_INVITE_WINDOW_MS=3600000
